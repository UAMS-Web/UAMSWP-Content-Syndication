# Shared starting PHPStan configuration for WordPress code
# (UAMS-Web/uams-claude-skills#10): plugins, must-use plugins, themes. Copy to
# the repository root as `phpstan.neon.dist` and fill in every PLACEHOLDER.
#
# Development dependencies:
#   composer require --dev phpstan/phpstan szepeviktor/phpstan-wordpress "php-stubs/wordpress-stubs:^6.8"
# Pin wordpress-stubs to 6.x (`^6.8`, as aether-wordpress-migration-api does). A bare
# `composer require php-stubs/wordpress-stubs` can resolve 7.1, which breaks
# szepeviktor/phpstan-wordpress. The extension loads the stubs itself; requiring
# the package pins the WordPress version the stubs describe.
# szepeviktor/phpstan-wordpress 2.x requires PHPStan 2.x; a repository on
# PHPStan 1.x upgrades both together.
#
# When the plugin or theme uses WP-CLI (`WP_CLI`, `WP_CLI::add_command()`, and
# friends), also:
#   composer require --dev php-stubs/wp-cli-stubs
# and uncomment the `scanFiles` block below. wp-cli-stubs needs wordpress-stubs
# 6.x as well, so the pin above covers both.
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    # PHPStan's opt-in preview channel: turns on rules and stricter analysis
    # that become default in the next major. Ships inside phpstan/phpstan (no
    # extra Composer dependency), but it is not cost-free against WordPress
    # stubs: bleedingEdge can break stub conditional return types (for example
    # `get_sites()`). Keep it while the repository analyzes cleanly; if a stub
    # return type starts failing only with this include, drop the include or
    # pin a narrow `ignoreErrors` entry with a comment naming the stub function
    # (see the code-quality skill).
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    # Optional, when the repository uses Mockery:
    # - vendor/phpstan/phpstan-mockery/extension.neon
    # When the tests run on Pest: Pest's own extension, shipped inside
    # pestphp/pest. It registers Pest's expectation classes as universal object
    # crates, so chained expectations analyze instead of reporting undefined
    # properties. Uncomment together with the Pest entries under ignoreErrors.
    - vendor/pestphp/pest/extension.neon

parameters:
    # The PHP versions the code must parse and run on: the supported floor (8.2) to
    # the developer's PHP (8.4).
    phpVersion:
        min: 80200
        max: 80400

    # The highest level the code passes today (see the code-quality skill); raised one
    # level per change as findings are fixed, until `max`.
    level: 9

    # First-party PHP, the plugin header file included.
    paths:
        - includes
        - uamswp-content-syndication.php
        - tests

    # Retired copies of the shortcode classes: nothing loads them and they
    # redeclare the live classes.
    excludePaths:
        analyse:
            - includes/_unused
            # The Integration suite's own Composer setup (the tests skill): its vendor/
            # sits inside tests, and PHPStan would otherwise analyze PHPUnit 9 and its
            # dependencies as this repository's code. It is absent in a unit-only clone.
            - tests/Integration/vendor (?)

    # The Integration suite's own Composer setup (the tests skill): its vendor/
    # sits inside `tests`, so it is excluded from analysis, under `analyse`
    # only, so its WordPress test classes can still be scanned below. Without
    # this, PHPStan analyzes PHPUnit 9 and its dependencies as if they were the
    # repository's code. Uncomment when tests/Integration has its own
    # composer.json.
    # excludePaths:
    #     analyse:
    #         - tests/Integration/vendor

    # Indexed for symbols but not analyzed. `php-stubs/wordpress-stubs` covers
    # core's runtime surface and stops there: `WP_UnitTestCase`, the factories
    # and `tests_add_filter()` ship with WordPress' test suite, not with
    # WordPress, and `WP_UnitTestCase` extends the polyfills' TestCase.
    # These paths belong to the Integration suite's isolated locked setup.
    # Run `composer setup:integration` before analysis, including on CI.
    scanDirectories:
        - tests/Integration/vendor/wp-phpunit/wp-phpunit/includes
        - tests/Integration/vendor/yoast/phpunit-polyfills/src

    # WP-CLI: uncomment after `composer require --dev php-stubs/wp-cli-stubs`.
    # Paths are relative to this neon file (repository root). wordpress-stubs
    # is already loaded by szepeviktor/phpstan-wordpress; list only the WP-CLI
    # stub files here.
    # scanFiles:
    #     - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    #     - vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
    #     - vendor/php-stubs/wp-cli-stubs/wp-cli-i18n-stubs.php
    #     - vendor/php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php

    # Constants defined from a function call (`define('MY_PLUGIN_URL',
    # plugin_dir_url(__FILE__))`, `plugin_dir_path()`, and similar) are often
    # invisible to PHPStan: it does not evaluate those calls when discovering
    # constants. Two remedies (pick one per constant):
    #
    # 1. A small bootstrap that `define()`s the same names to plain string (or
    #    path) stand-ins, listed under `bootstrapFiles`. Prefer this when code
    #    concatenates the constant and needs a known string type.
    # 2. List the constant under `dynamicConstantNames` when its value varies by
    #    environment and you only need PHPStan to treat it as defined (and not
    #    fold a specific value).
    #
    # Example (uncomment and rename to the plugin's real constants):
    # bootstrapFiles:
    #     - phpstan-bootstrap.php
    # dynamicConstantNames:
    #     - MY_PLUGIN_URL
    #     - MY_PLUGIN_DIR

    # Checkout-scoped cache. PHPStan's default tmpDir is
    # `sys_get_temp_dir()/phpstan`: machine-global, shared by every checkout and
    # worktree on the machine. The cache stores ABSOLUTE phar paths, so deleting
    # the worktree that populated it leaves every stored path dangling, and the
    # next run in a live checkout dies with internal errors of the form
    # `"phar://.../vendor/phpstan/phpstan.phar/..." is not a file`, blaming
    # whichever source file happened to be under analysis. That reads as a real
    # defect in the diff.
    #
    # Neither obvious remedy works: `clear-result-cache` leaves most of the
    # directory in place, and `rm -rf` races any concurrent session analyzing
    # in it. A RELATIVE path resolves against this file's directory, so each
    # checkout gets its own cache and a deleted one takes only its own with it.
    # There is no `--tmp-dir` CLI flag, so this key is the only lever.
    # Add `/.phpstan/` to .gitignore.
    tmpDir: .phpstan

    # WordPress ships a very large global function surface; the stubs cover it,
    # but core's own docblocks are loose enough that a few dynamic returns
    # cannot be narrowed. Add ignores here only with a comment naming the core
    # function responsible, pinned by `identifier` and `path`. Never a blanket
    # pattern. Unmatched entries fail the run (`reportUnmatchedIgnoredErrors`
    # defaults to true), so a stale ignore reds rather than rots.
    #
    # The template ships with no active entry, so a first run at `level: 0` on
    # clean code passes. An entry whose error does not occur fails the run as
    # `ignore.unmatched` unless it says `reportUnmatched: false`, so uncomment
    # each entry below only when its error appears (the Pest entries: when the
    # tests run on Pest). The entries already sit in the list, at the list's
    # indentation, so removing the leading `# ` from an entry's lines is all
    # an entry needs. With every entry commented out the key is empty, which
    # PHPStan reads as no entries.
    ignoreErrors:
        # The Unit suite hands state from `beforeEach()` to each test through
        # properties on `$this`. Pest types a test closure's `$this` as `TestCall`
        # (`@param-closure-this`), which declares none of them. A stub declaring
        # them cannot name the plugin classes: PHPStan validates stubs before the
        # analyzed paths are indexed, and no autoload or bootstrap setting changed
        # that. The properties read as `mixed` meanwhile.
        -
            identifier: property.notFound
            message: '#^Access to an undefined property Pest\\PendingCalls\\TestCall::\$\w+\.$#'
            path: tests/Unit
            reportUnmatched: false
        # `create_function()` was removed in PHP 8.0. The call sits in the plugin
        # header's guard for PHP below 5.3, a branch that never runs on the
        # supported 8.2 floor. Removing the dead guard is a separate change.
        -
            identifier: function.notFound
            message: '#^Function create_function not found\.$#'
            path: uamswp-content-syndication.php

        # `shortcode_ui_register_for_shortcode()` belongs to the Shortcode UI
        # (Shortcake) plugin. The only call sits in `build_shortcake()`, which is
        # hooked only when the `UAMS_Shortcakes` class exists, and the plugin's
        # stubs are not installed here.
        -
            identifier: function.notFound
            message: '#^Function shortcode_ui_register_for_shortcode not found\.$#'
            path: includes/class-uams-syndicate-shortcode-news.php
        # The plugin header's `version_compare(PHP_VERSION, '5.3', '<')` guard is
        # always false at the supported 8.2 floor, and PHPStan reports
        # `if.alwaysFalse` from level 4. The guard predates the floor; removing it
        # together with the `create_function()` call inside it is a separate change.
        -
            identifier: if.alwaysFalse
            path: uamswp-content-syndication.php

        # When the Unit tests run on Pest (with the extension above), two
        # entries, each pinned to `tests/`, so the same error anywhere else
        # still fails. They carry `reportUnmatched: false` because whether they
        # match depends on the level and on which calls a suite happens to
        # make: the internal-class entry matches only from level 2, and a suite
        # whose `Pest.php` never uses `$this` has nothing for the first entry to
        # match. Measured on the `tests` skill's WordPress plugin template with
        # PHPStan 2.3.0 and Pest 5.3.0, 2026-10-07: without the first it fails
        # at level 0. The Integration suite is class-based PHPUnit 9.6 and
        # needs no entry of its own.
        #
        # `$this` inside a closure passed to `uses()->beforeEach()` /
        # `afterEach()` is bound by Pest at runtime, which PHPStan cannot see.
        -
            identifier: variable.undefined
            message: '#^Undefined variable: \$this$#'
            path: tests/Pest.php
            reportUnmatched: false
        # Pest routes its public API through classes it tags @internal;
        # calling them from a test is Pest's intended use.
        -
            identifier: method.internalClass
            message: '#of internal class Pest\\#'
            path: tests
            reportUnmatched: false
