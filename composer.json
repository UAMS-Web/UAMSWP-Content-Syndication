{
    "name": "uams-web/uamswp-content-syndication",
    "description": "UAMSWP Content Syndication plugin. Development dependencies only: nothing here is installed on a site.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "pest",
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "refactor": "rector",
        "refactor:sweep": "rector --clear-cache --config=rector-sweep.php",
        "test:refactor": "rector --dry-run",
        "test:refactor:sweep": "rector --dry-run --clear-cache --config=rector-sweep.php",
        "pint": "pint",
        "test:pint": "pint --test"
    },
    "scripts-descriptions": {
        "test": "Run the suite.",
        "test:unit": "Run the Pest suite that needs no WordPress and no database.",
        "stan": "Run PHPStan at the level phpstan.neon.dist names.",
        "refactor": "Apply the gating Rector profile.",
        "refactor:sweep": "Apply the sweep Rector profile (run deliberately, review the diff).",
        "test:refactor": "Preview the gating Rector profile.",
        "test:refactor:sweep": "Preview the sweep Rector profile.",
        "pint": "Format with Pint.",
        "test:pint": "Check formatting with Pint."
    }
}
